# Copy to /srv/iam/shared/iam.env; chmod 600. Never commit filled files.
# Quote every value, especially secrets with # or spaces. Single-line dotenv only.
INSTALLATION="@@INSTALLATION@@"
NODE_ENV="production"
APP_ENV="prod"
HOSTNAME="127.0.0.1"
PORT="3001"
TZ="America/Bogota"
SCHEDULER_TIMEZONE="America/Bogota"
NEXT_PUBLIC_APP_URL="@@APP_URL@@"
# The contract already adds /api/v1: this must be the origin, not /api/v1 or /portal.
NEXT_PUBLIC_API_URL="@@API_URL@@"
NEXT_PUBLIC_STORAGE_URL="@@STORAGE_URL@@"
IAM_ISSUER="@@APP_URL@@"
IAM_APP_SLUG="iam"
IAM_DEFAULT_ACCOUNT_SLUG="CHANGE_ME"
# Percent-encode the password. Agree the hostname, TLS and CA with TI.
DATABASE_URL="postgresql://iam_runtime:CHANGE_ME@CHANGE_ME_DB_HOST:5432/iam?sslmode=verify-full&sslrootcert=/srv/iam/shared/postgres-ca.crt"
EXPECTED_DATABASE="iam"
EXPECTED_DB_HOST="CHANGE_ME_DB_HOST"
RESEND_API_KEY="CHANGE_ME"
RESEND_MAIL_FROM="CHANGE_ME"
DO_SPACES_ENDPOINT="CHANGE_ME"
DO_SPACES_REGION="CHANGE_ME"
DO_SPACES_BUCKET="CHANGE_ME"
DO_SPACES_KEY="CHANGE_ME"
DO_SPACES_SECRET="CHANGE_ME"
