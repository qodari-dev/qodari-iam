[Unit]
Description=IAM application
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# Replace with the deployment user/group agreed with TI.
User=CHANGE_ME_OPERATOR
Group=CHANGE_ME_OPERATOR
WorkingDirectory=/srv/iam/current/app
Environment=IAM_ENV_FILE=/srv/iam/shared/iam.env
Environment=NODE_ENV=production
Environment=TZ=America/Bogota
# Confirm /usr/bin/node with command -v node before installing this unit.
ExecStart=/usr/bin/node /srv/iam/current/ops/start.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
SyslogIdentifier=iam
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
