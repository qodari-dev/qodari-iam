# Initial account only. Copy to shared/bootstrap.env, chmod 600. Remove after initialization.
# Account/app slugs come from iam.env. Use a unique initial admin password (16+ chars).
BOOTSTRAP_ACCOUNT_NAME="CHANGE_ME"
BOOTSTRAP_ADMIN_EMAIL="CHANGE_ME"
BOOTSTRAP_ADMIN_FIRST_NAME="CHANGE_ME"
BOOTSTRAP_ADMIN_LAST_NAME="CHANGE_ME"
BOOTSTRAP_ADMIN_PASSWORD="CHANGE_ME"
# Choose these according to the agreement, not the number of affiliates alone.
BOOTSTRAP_PLAN_KEY="CHANGE_ME"
BOOTSTRAP_PLAN_NAME="CHANGE_ME"
BOOTSTRAP_PLAN_PRICE="CHANGE_ME"
BOOTSTRAP_MAX_USERS="CHANGE_ME"
BOOTSTRAP_MAX_APPLICATIONS="CHANGE_ME"
