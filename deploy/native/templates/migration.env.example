# Copy to /srv/iam/shared/migration.env; chmod 600.
# Use the owner/migrator role, not the runtime role or SSH/superuser password.
DATABASE_URL="postgresql://iam_migrator:CHANGE_ME@CHANGE_ME_DB_HOST:5432/iam?sslmode=verify-full&sslrootcert=/srv/iam/shared/postgres-ca.crt"
EXPECTED_DATABASE="iam"
EXPECTED_DB_HOST="CHANGE_ME_DB_HOST"
